<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application de bureau WPF (Windows uniquement). Elle consomme GhostAndroid.Core.
    La compilation exige Windows + .NET 8 SDK (voir le workflow GitHub Actions
    windows-latest, qui compile et publie réellement ce projet).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GhostAndroid.App</RootNamespace>
    <AssemblyName>GhostAndroid</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ghost.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhostAndroid.Core\GhostAndroid.Core.csproj" />
  </ItemGroup>

  <!-- L'icône est générée au build si absente ; un placeholder est fourni. -->
  <ItemGroup>
    <None Update="Assets\ghost.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\ghost.ico')" />
  </ItemGroup>

</Project>

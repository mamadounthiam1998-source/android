<UserControl
    x:Class="GhostAndroid.App.Views.FirmwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Firmware &amp; mise à jour" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Identification de l'appareil et vérification des conditions de sécurité avant toute opération firmware." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Identifier l'appareil"
                    Style="{StaticResource PrimaryButton}" Command="{Binding IdentifyCommand}" />
        </Grid>

        <!-- Avertissement d'honnêteté -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBlue}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="20" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Top" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Identité &amp; firmware" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Identity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Conditions de sécurité" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SafetyChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Foreground="{StaticResource Success}" FontWeight="Bold"
                                                       Visibility="{Binding Passed, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                            <TextBlock Text="•" Foreground="{StaticResource Warning}" FontWeight="Bold"
                                                       Visibility="{Binding Passed, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   Margin="18,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="GhostAndroid.App.Views.ConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Console ADB / Fastboot" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Exécution réelle. Les commandes destructives demandent une confirmation. L'appareil sélectionné est ciblé automatiquement (-s)." />
        </StackPanel>

        <!-- Barre d'actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cible : " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Context.SelectedDevice.DisplayName, FallbackValue='Aucun appareil', TargetNullValue='Aucun appareil'}"
                                   Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Content="ADB" GroupName="mode" IsChecked="{Binding FastbootMode, Converter={StaticResource InverseBool}}"
                                     Foreground="{StaticResource TextPrimary}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <RadioButton Content="Fastboot" GroupName="mode" IsChecked="{Binding FastbootMode}"
                                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="devices" Command="{Binding QuickCommand}" CommandParameter="devices" />
                    <Button Content="getprop" Command="{Binding QuickCommand}" CommandParameter="getprop" />
                    <Button Content="batterie" Command="{Binding QuickCommand}" CommandParameter="battery" />
                    <Button Content="logcat" Command="{Binding QuickCommand}" CommandParameter="logcat" />
                    <Button Content="reboot" Command="{Binding QuickCommand}" CommandParameter="reboot" />
                    <Button Content="→ recovery" Command="{Binding QuickCommand}" CommandParameter="recovery" />
                    <Button Content="→ bootloader" Command="{Binding QuickCommand}" CommandParameter="bootloader" />
                    <Button Content="fastboot devices" Command="{Binding QuickCommand}" CommandParameter="fb-devices" />
                    <Button Content="getvar all" Command="{Binding QuickCommand}" CommandParameter="fb-getvar" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Sortie -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="2">
            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextChanged="OnOutputChanged"
                     Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                     Foreground="#FFB9F5E6" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" Padding="14" />
        </Border>

        <!-- Saisie -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center" Height="42"
                     Tag="Saisir une commande (ex: shell pm list packages)">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RunCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Exécuter" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <Button Grid.Column="2" Content="Effacer" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Command="{Binding ClearCommand}" />
        </Grid>
    </Grid>
</UserControl>

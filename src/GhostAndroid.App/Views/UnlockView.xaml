<UserControl
    x:Class="GhostAndroid.App.Views.UnlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Verrous &amp; accès" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Diagnostic de sécurité en lecture seule. Aucun contournement de verrou n'est effectué." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Diagnostiquer"
                    Style="{StaticResource PrimaryButton}" Command="{Binding DiagnoseCommand}" />
        </Grid>

        <!-- Politique -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBlue}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡" FontSize="20" VerticalAlignment="Top" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Policy}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- État -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Chiffrement du stockage" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StorageEncryption}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Déverrouillage OEM" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OemUnlock}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Verrou d'écran" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ScreenLock}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Notes + action -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Notes de diagnostic" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Background="#1AFF4D4F" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reprise d'accès autorisée" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       Text="En cas d'oubli de code sur un appareil vous appartenant, la seule option est une réinitialisation d'usine (effacement total), confirmée manuellement sur l'appareil." />
                            <Button Content="Réinitialisation d'usine autorisée…" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left" Command="{Binding FactoryResetCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="GhostAndroid.App.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Sauvegarde &amp; restauration" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Sauvegardes chiffrées AES-256-GCM des données accessibles. Vérification d'intégrité SHA-256." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Gauche : configuration -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Catégories à sauvegarder" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,10" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected}" Margin="0,5" Foreground="{StaticResource TextPrimary}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding DevicePath}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Mot de passe de chiffrement" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                        <PasswordBox PasswordChanged="OnPasswordChanged" Height="40" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ProgressStage}" Foreground="{StaticResource AccentCyan}" FontSize="12" Margin="0,0,0,6" />
                        <ProgressBar Style="{StaticResource ModernProgress}" Value="{Binding Progress}" Maximum="100" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Sauvegarder" Style="{StaticResource PrimaryButton}" Command="{Binding BackupCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                        <Button Content="Restaurer…" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                        <Button Content="Vérifier…" Style="{StaticResource GhostButton}" Command="{Binding VerifyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Droite : limitations + historique -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource Warning}">
                    <StackPanel>
                        <TextBlock Text="⚠ Données non incluses" Foreground="{StaticResource Warning}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding KnownLimitations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Historique des sauvegardes" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,10" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceModel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:g}'}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding FileCount}" />
                                                <Run Text=" fichiers · " />
                                                <Run Text="{Binding TotalBytes, Converter={StaticResource BytesToHuman}}" />
                                                <Run Text=" · 🔒 chiffré" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

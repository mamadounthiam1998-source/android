<Application
    x:Class="GhostAndroid.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GhostAndroid.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:ConnectionModeToBrushConverter x:Key="ModeToBrush" />
            <conv:BytesToHumanConverter x:Key="BytesToHuman" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
